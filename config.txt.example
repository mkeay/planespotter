[DEFAULT]
# IRC Configuration
server = irc.network
port = 6667
nickname = nickname
realname = a real name
channel = #channel
bot_message_delay = 1

# Greet particular nicks as they join: "nick:message" pairs separated by ";".
# The nick is prefixed automatically. Leave blank to disable.
# greet_nicks = somenick:welcome back
greet_nicks =

# Station callsign — used when configuring SondeHub feeding
# (radiosonde_auto_rx station.cfg) and other uploader integrations
station_callsign = N0CALL

# Location Configuration (reference point for distance/bearing/ETA)
reference_lat = xx.xxxx
reference_lon = xx.xxxx

# Data Source (readsb/tar1090 JSON, read straight from disk)
local_json = /run/readsb/aircraft.json
poll_seconds = 10
recheck_seconds = 30
state_file = last_alert_time.json

# Alert history (SQLite). Every line sent to the channel is appended here
# with the full aircraft record behind it, so the corpus survives reboots --
# the journal is often RAM-only and holds hours, not months. Receiver up/down
# transitions are recorded in the same file, which is what lets a later
# analysis tell "nothing flew over" apart from "the dongle was unplugged".
# Leave empty to disable.
alert_db = /home/pi/alerts.db

# Who to message privately when the local feed stops being readable -- a dead
# dongle is otherwise silent, since the channel just goes quiet while the
# online ring carries on. Empty disables the notice. The reminder repeats on
# this interval while the fault stands; 0 sends it once only.
alert_nick =
receiver_alert_repeat_hours = 6

# Online check: alerts on watchlist aircraft nearby that the local receiver
# can't see (terrain-masked), tagged "(online data)". adsb.lol is a free
# aggregator; adsb.fi and airplanes.live use the same URL/response format.
# Wide enough that an aircraft descending out of a neighbouring terminal area
# is seen on the way down, not just once it's nearly overhead.
online_enabled = false
online_radius_nm = 55
online_poll_seconds = 60
online_url = https://api.adsb.lol/v2/point/{lat}/{lon}/{radius}

# Wide sweep, counting only -- it does not alert. It used to post a "Heads up"
# for any aircraft holding a converging course (steady bearing, closing range),
# but that shape means very little at this radius: a straight-line overflight
# that will miss by 80 miles shows it for the whole approaching half of its
# pass. In practice it fired constantly on transatlantic transports at
# FL300-350 that were never coming here and couldn't be seen or heard anyway.
# It now just tallies distinct high-altitude military contacts for the daily
# digest -- the interesting part being how many of them there are.
long_range_enabled = false
long_range_radius_nm = 150
long_range_poll_seconds = 180

# Optional: POST each alert to this URL (leave blank to disable)
webapi =

# Extra alert triggers: military flag (dbFlags; needs readsb --db-file for
# local traffic, free from the aggregator) and local MLAT-only targets
# (aircraft without ADS-B positioned by the MLAT network — often military)
alert_military = true
alert_mlat = true

# Exclusion zones: skip alerts (except emergencies) for aircraft below
# an altitude near these points, as lat,lon,radius_nm,below_alt_ft with
# ";" between zones — e.g. a nearby airport's circuit and approaches,
# while overflights above the cutoff still alert. Leave blank to disable.
# exclude_zones = 55.5094,-4.5867,15,15000
exclude_zones =

# Airports whose arrivals are someone else's business. Same format plus an
# optional name, and used two ways: traffic sitting inside one of these below
# its cutoff is ignored, and traffic *lined up on* one — descending, or
# holding level close in below the cutoff — is treated as an arrival there
# rather than a visitor, which is what a jet letting down toward a
# neighbouring airport looks like when it happens to point your way.
# Watchlist traffic isn't suppressed; with a name set, its alert says
# "probably landing at <name>" instead.
# airport_zones = 55.5094,-4.5867,15,15000,Prestwick; 55.8719,-4.4331,12,15000,Glasgow
airport_zones =

# Append a planespotters.net photo link to alerts
photo_links = true

# Announce spool: other services (dumpvdl2, radiosonde_auto_rx,
# raspberry-noaa hooks, cron...) drop text files here — e.g. via the
# norris-say helper — and each line is relayed to the IRC channel.
# Leave blank to disable.
announce_dir =

# Radiosonde alerts from SondeHub (community aggregator; works without
# a local sonde receiver — a local one just makes you a contributor).
# Alerts once when a sonde is sighted in radius and again when it starts
# descending, with a sondehub.org tracking link.
sonde_enabled = false
sonde_radius_km = 75
sonde_poll_seconds = 300
sonde_max_age_minutes = 30

# Daily receiver stats digest to IRC
digest_enabled = true
digest_time = 08:00
stats_json = /run/readsb/stats.json

# Nightly astronomy almanac, posted astro_lead_minutes before sunset:
# sunset/sunrise, moon phase & full-moon countdown, darkness times and
# best observing window (Clear Outside, primary; Open-Meteo fallback),
# seeing/transparency (7Timer!), a 0-100 clear-sky score, frost/snow
# warnings only when expected, and a bins-out reminder on the eve of a
# collection day (needs bins_ical_url below).
#
# It also carries, computed locally with no network involved:
#   - which naked-eye planets get up tonight, how high and when
#   - a lunar eclipse, but only on the nights there is one and only
#     when the moon is above the horizon here for it
#   - three deep-sky targets well placed at the darkest hour, but only
#     when seeing AND transparency are "average" or better -- no point
#     sending anyone out after a faint galaxy through poor transparency
# The morning briefing likewise mentions a solar eclipse only on a day
# there is one visible from these coordinates.
astro_enabled = false
astro_lead_minutes = 60

# Aurora alerts. Checked every aurora_poll_minutes through the dark
# hours (sun more than 6 degrees down) rather than saved for the nightly
# report, because the aurora doesn't wait for sunset. Silent unless
# something is actually happening, and silent when the sky is more than
# 80% clouded over -- no alert for an aurora nobody could see.
#
# Sources: AuroraWatch UK (Lancaster University magnetometers -- a
# nowcast, status credited in the message as their terms require) and
# NOAA SWPC's Kp forecast for the hours ahead. Either can trigger it;
# the Kp threshold is worked out from your latitude (roughly Kp 5 at
# 56 N, Kp 7 at 52 N).
#
# aurora_min_status: lowest AuroraWatch level worth an alert --
# yellow (camera-only activity), amber (naked eye from Scotland and
# northern England) or red (naked eye anywhere in the UK). Below about
# 56 N, yellow is ignored regardless: it doesn't reach that far south.
# aurora_repeat_hours: an escalation always alerts; the same level
# re-alerts only after this long.
aurora_enabled = false
aurora_min_status = amber
aurora_poll_minutes = 15
aurora_repeat_hours = 3

# Morning briefing at morning_time (local): saints'/national/
# international days, bin collection from a council iCal feed (only
# mentioned when a collection is due; kind of bin only, never the
# address; leave bins_ical_url blank to skip), today's weather
# (Open-Meteo), and tonight's likely-visible ISS passes
# (api.g7vrd.co.uk, >= iss_min_elevation degrees at peak)
morning_enabled = false
morning_time = 06:00
bins_ical_url =
iss_min_elevation = 10

# Watchlist & Alert Settings
#
# altitude_threshold: plain civilian traffic only alerts below this, and only
# when the local receiver can see it.
#
# alert_ceiling_ft: the see/hear ceiling. Above it nothing alerts except the
# hand-picked watchlist_aircraft and emergencies — if it can't be seen or heard
# from the ground, there's little point interrupting for it. High-altitude
# military is counted and reported once a day by the digest instead. This is
# the single biggest noise control: on the author's receiver ~64% of alerts
# were above 8000 ft, essentially all of it airway traffic passing through.
#
# inbound_cpa_nm: how close an aircraft's projected path must pass to count as
# actually coming here. "Pointing roughly this way" is not enough — most
# airway traffic points at you for a while en route to somewhere else.
altitude_threshold = 3000
alert_ceiling_ft = 8000
inbound_cpa_nm = 25
alert_interval_minutes = 15
verbose = False

# "Went low and vanished heading our way": something low and tracking toward
# you that drops off the feed short of the local receiver, rather than landing
# somewhere or carrying on past. In hilly terrain that's what an arrival looks
# like — it drops below every receiver's horizon before it gets to you.
vanish_alert_enabled = true
vanish_max_dist_nm = 40

# Squawk codes; single codes or ranges (e.g. 7500,7600-7700). 0020 and 0036
# only alert within SQUAWK_DISTANCE_LIMITS_MI's radius (spotter.py) -- 6 and
# 3 miles respectively -- since they're common conspicuity codes elsewhere.
# Alerts annotate the squawk with what it is for, or who controls it,
# under the UK SSR code assignment plan -- "0020 (air ambulance / HEMS
# medivac)", "0036 (helicopter pipeline/powerline inspection)", "5271
# (transit code, Channel Islands)" -- from the tables in squawks.py,
# which cover all 4096 codes. Where a code is shared between units too
# far apart to clash, the most specific few are listed.
watchlist_squawks = 0001,0020,0036,7500,7700
# ADS-B emitter categories (A6/A7 = high performance/rotorcraft etc.)
watchlist_categories = A6,A7,B2,B3,B4,B6,B7
# ICAO hex codes, comma separated
watchlist_aircraft = 43c6f9,ae4ae8

# Callsign prefixes that alert wherever they're going, at any altitude —
# for outfits that fly whichever airframe is serviceable (display teams,
# QRA flights), where a hex watchlist can't follow them
watchlist_callsigns = REDARROW

# Type codes tagged (Zzz) instead of Alert! — traffic you can identify by
# ear before reading the line, so it should inform without exciting
snooze_types = R22,R44,R66

# Behavioural detectors, alerting on what an aircraft is doing rather than
# what it is. Loitering: two full turns' worth of accumulated course change
# from an orbit of up to roughly loiter_radius_nm radius — police/SAR
# orbits; local data, only at or below alert_ceiling_ft and within 15 nm
# ("something is working YOUR area"), gliders/ultralights excluded,
# re-announced hourly while it keeps circling. Formation: two or more
# airborne military aircraft in close company (co-level, matched
# speed/heading, within formation_max_sep_nm) for formation_min_sweeps
# consecutive online sweeps — alerts at ANY altitude, one announcement per
# flight; a re-alert needs a new member or six hours. Survey: 20+ minutes
# of lawnmower legs on one axis marching steadily across an area (the
# march is what distinguishes it from a hold) — any altitude, 6 h
# per-aircraft cooldown.
loiter_alert_enabled = true
loiter_radius_nm = 4
formation_enabled = true
formation_max_sep_nm = 2
formation_min_sweeps = 3
survey_enabled = true

# Optional elevation grid for height-above-ground in alert text ("at
# altitude 3400 ft (≈900 ft AGL)") — barometric altitude flatters
# everything in hill country. Build once with tools/build_terrain.py from
# the free OS Terrain 50 download (GB only). Blank disables.
terrain_grid =
